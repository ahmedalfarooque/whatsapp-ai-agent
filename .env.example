# =====================================================================
# WhatsApp AI Agent — environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# =====================================================================

# ---------------------------------------------------------------------
# Application mode
# ---------------------------------------------------------------------
# development (default) or test:
#   Real credentials below (WhatsApp, OpenRouter, Google) are NOT required.
#   The app automatically uses built-in mock providers instead — no real
#   WhatsApp message is ever sent, no real Google Calendar event is ever
#   created, and no real OpenRouter/AI call is ever made. Look for
#   "[MOCK ...]" log lines confirming this at runtime. This lets you run
#   `npm run dev` and exercise the full pipeline (webhook, memory, restart,
#   tool calling, booking flow, etc.) with zero external accounts set up.
#
# production:
#   Every credential below becomes REQUIRED. The app refuses to start
#   (see src/config/env.ts) if any is missing, and always uses the real
#   WhatsApp/OpenRouter/Google Calendar integrations — it can never fall
#   back to a mock in this mode.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# SQLite database file path (inside the container this should be under
# a mounted volume, e.g. /app/data/app.db)
DATABASE_PATH=./data/app.db

# ---------------------------------------------------------------------
# Meta WhatsApp Cloud API — REQUIRED ONLY when NODE_ENV=production.
# Get these from developers.facebook.com -> your app -> WhatsApp -> API Setup
# ---------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_PERMANENT_OR_SYSTEM_USER_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
# You choose this value yourself and enter the SAME value in the Meta
# webhook configuration screen (Callback Verify Token).
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_A_RANDOM_STRING_YOU_CHOOSE
# App Settings -> Basic -> App Secret. Used to validate X-Hub-Signature-256.
META_APP_SECRET=REPLACE_WITH_META_APP_SECRET
# Graph API version, update as Meta deprecates old versions.
WHATSAPP_API_VERSION=v21.0

# ---------------------------------------------------------------------
# OpenRouter (LLM provider) — REQUIRED ONLY when NODE_ENV=production.
# https://openrouter.ai/keys
# ---------------------------------------------------------------------
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
# Any OpenRouter-supported model id. Swap without code changes.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional but recommended by OpenRouter for attribution/rate-limit tiers.
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_APP_NAME=WhatsApp AI Agent

# ---------------------------------------------------------------------
# Google Calendar (service account — no user OAuth flow) — GOOGLE_CLIENT_EMAIL
# and GOOGLE_PRIVATE_KEY are REQUIRED ONLY when NODE_ENV=production.
# 1. Create a Google Cloud project + service account with the Calendar API enabled.
# 2. Download the service account JSON key.
# 3. Share the target Google Calendar with the service account's client_email
#    (Settings and sharing -> Share with specific people -> "Make changes to events").
# ---------------------------------------------------------------------
GOOGLE_CLIENT_EMAIL=REPLACE_WITH_SERVICE_ACCOUNT_EMAIL
# Paste the private_key from the JSON key file. Keep the \n escape sequences
# literal (the app converts them to real newlines at startup).
GOOGLE_PRIVATE_KEY="REPLACE_WITH_SERVICE_ACCOUNT_PRIVATE_KEY"
GOOGLE_CALENDAR_ID=primary
GOOGLE_PROJECT_ID=REPLACE_WITH_GCP_PROJECT_ID

# ---------------------------------------------------------------------
# Business configuration
# ---------------------------------------------------------------------
BUSINESS_NAME=Example Business
# IANA timezone name, e.g. Asia/Karachi, America/New_York, Europe/London
BUSINESS_TIMEZONE=UTC
BUSINESS_PHONE=+10000000000
BUSINESS_EMAIL=contact@example.com
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
# Comma-separated 1(Mon)-7(Sun) days the business is open.
BUSINESS_DAYS=1,2,3,4,5,6

BOOKING_DURATION_MINUTES=30
BOOKING_BUFFER_MINUTES=0

# ---------------------------------------------------------------------
# Conversation / agent behavior
# ---------------------------------------------------------------------
RESTART_KEYWORDS=restart,reset,start over
CONVERSATION_HISTORY_LIMIT=20
MAX_TOOL_ROUNDS=4
OPENROUTER_TIMEOUT_MS=30000
WHATSAPP_TIMEOUT_MS=15000
GOOGLE_TIMEOUT_MS=15000

# ---------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------
# Max accepted JSON body size for webhook payloads.
MAX_BODY_SIZE=1mb
# Requests per minute allowed per source IP on the webhook endpoint.
RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------
# Deployment (docker-compose / Caddy)
# Your real domain, already pointed at this VPS via a DNS A/AAAA record.
# Caddy uses this to request an HTTPS certificate automatically.
# ---------------------------------------------------------------------
DOMAIN=whatsapp-agent.example.com
