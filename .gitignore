node_modules/
dist/
coverage/

# Runtime data — never commit
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
!data/.gitkeep

# Secrets — never commit
.env
.env.local
.env.*.local
secrets/*.json
!secrets/.gitkeep

# Editor/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Local coordination runtime; instructions/handoffs remain versionable
.project-sync/writer.json
.project-sync/report.json
.project-sync/**/*.tmp

# Caddy runtime state
caddy_data/
caddy_config/

# Dashboard knowledge-file edit backups (runtime, never business content of record)
knowledge/.backups/

.vercel
